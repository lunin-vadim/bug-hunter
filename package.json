{
  "name": "bug-hunter-fullscreen",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Bug Hunter: полноэкранная браузерная игра с авторизацией и рейтингом (PostgreSQL)",
  "main": "server.js",
  "scripts": {
    "start": "lsof -ti:3131 | xargs kill -9 2>/dev/null || true && node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js",
    "db:start": "bash scripts/db-start.sh",
    "db:stop": "bash scripts/db-stop.sh",
    "db:backup": "bash scripts/backup.sh",
    "db:fetch-backup": "bash scripts/fetch-backup.sh"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
